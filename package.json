{
  "name": "@guillaume-docquier/oxfmt",
  "version": "0.0.0-semantically-released",
  "description": "Shared Oxfmt configuration for my TypeScript projects",
  "homepage": "https://github.com/Guillaume-Docquier/oxfmt",
  "license": "MIT",
  "author": "Guillaume Docquier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guillaume-Docquier/oxfmt.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "checks": "pnpm format:fix && pnpm typecheck && pnpm build",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "prepack": "pnpm build",
    "prepare": "husky",
    "typecheck": "tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "oxfmt": "^0.79.0",
    "semantic-release": "^26.0.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "oxfmt": ">=0.77.0"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  }
}
